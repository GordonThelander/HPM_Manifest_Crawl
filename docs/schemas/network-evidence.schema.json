{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GordonThelander/HPM_Manifest_Crawl/blob/main/docs/schemas/network-evidence.schema.json",
  "title": "HPM network evidence guide",
  "type": "object",
  "required": ["schemaVersion", "dataset", "snapshotGenerated", "method", "packageCount", "counts", "packages"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "dataset": {"const": "network-evidence-guide"},
    "snapshotGenerated": {"type": ["string", "null"]},
    "method": {"type": "object"},
    "packageCount": {"type": "integer", "minimum": 0},
    "counts": {"type": "object"},
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "declared", "observed", "reviewed", "classification"],
        "properties": {
          "id": {"type": ["string", "null"]},
          "name": {"type": ["string", "null"]},
          "declared": {"type": "object"},
          "observed": {"type": "object"},
          "reviewed": {"type": "array"},
          "classification": {"enum": ["LAN", "CLOUD", "BOTH", "INSUFFICIENT"]}
        }
      }
    }
  }
}
