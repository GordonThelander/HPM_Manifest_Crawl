{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gordonthelander.github.io/HPM_Manifest_Crawl/schemas/site-status.schema.json",
  "title": "Community Utilities site status",
  "type": "object",
  "required": ["schemaVersion", "dataset", "generatedAt", "repositoryUrl", "lastSuccessfulHpmCrawl", "counts", "sources", "flow", "automationMapContract", "method"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "dataset": {"const": "community-utilities-site-status"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "repositoryUrl": {"type": "string", "format": "uri"},
    "lastSuccessfulHpmCrawl": {"type": "string", "format": "date-time"},
    "counts": {"type": "object", "required": ["sources", "states"]},
    "sources": {"type": "array", "minItems": 10, "items": {"$ref": "#/$defs/source"}},
    "flow": {"type": "array", "minItems": 4},
    "automationMapContract": {"type": "object", "required": ["canonicalPath", "slimPath", "schemaVersion", "canonicalEntries", "slimEntries", "relationship", "requiredForSite", "siteRequiredForAutomationMap"]},
    "method": {"type": "object", "required": ["fileModificationTimesUsedAsCrawlTime", "unknownAcquisitionTimesRemainNull", "failedBuildReplacesOutput", "remoteContentRendered", "automationMapRegistriesWritten"]}
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["id", "name", "authority", "role", "url", "acquisition", "state", "observedAt", "lastAttempt", "lastSuccess", "retainedSnapshot", "recordsProduced", "evidence", "outputs", "sourceUpdatedAt"],
      "properties": {
        "state": {"enum": ["HEALTHY", "DEGRADED", "STALE", "UNAVAILABLE", "MANUALLY_REVIEWED"]},
        "lastAttempt": {"type": ["string", "null"]},
        "lastSuccess": {"type": ["string", "null"]},
        "recordsProduced": {"type": "integer", "minimum": 0}
      }
    }
  }
}
