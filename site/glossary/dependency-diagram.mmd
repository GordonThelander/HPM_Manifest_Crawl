flowchart LR
    subgraph EW["Physical / External World"]
        PD["Physical Devices<br/>Sensors - Actuators - Bridges"]
        ES["External Services / Systems<br/>Cloud APIs - HA - Node-RED - Custom services"]
        OH["Other Hubitat Hub"]
    end

    subgraph TP["Transport / Protocol"]
        ZB["Zigbee<br/>Clusters - Attributes - Commands"]
        ZW["Z-Wave<br/>Command Classes - Parameters"]
        MT["Matter / Thread<br/>Clusters - Endpoints - IPv6"]
        LAN["LAN / IP / Cloud<br/>HTTP - REST - WebSocket - SSE - TCP/UDP"]
    end

    subgraph HE["Hubitat Elevation Platform"]
        DR["Driver Layer<br/>Protocol abstraction + device representation"]
        DEV["Hubitat Device Object<br/>Physical - Virtual - Parent/Child - Component"]
        CAP["Capability Interface<br/>Standard commands + attributes"]
        STATE["Device State / Events<br/>Attributes - Current state - Device events"]

        SUB["Event Runtime<br/>Subscriptions - Event handlers"]
        SCH["Hub Scheduler<br/>Scheduled jobs - Delays - Repeats"]

        APP["Application Layer<br/>Rule Machine - Room Lighting - HSM - Other apps"]
        AUT["Automation State / Context<br/>Conditions - Required Expression - Mode - Variables"]
        HV["Hub Variables<br/>Shared typed state"]
        RF["Rule Function / Rule-to-Rule<br/>Reusable / delegated automation logic"]
        ACT["Actions / Commands<br/>Device commands - App actions - HTTP actions"]

        API["Maker API / HTTP Endpoints<br/>External integration boundary"]
        HM["Hub Mesh<br/>Shared devices + Hub Variables"]
        DIAG["Operations / Diagnostics<br/>Logs - Event history - App status - Device status"]
    end

    PD -->|RF| ZB
    PD -->|RF| ZW
    PD -->|IP / Thread| MT
    PD -->|IP| LAN
    ES -->|API / network| LAN

    ZB -->|protocol message| DR
    ZW -->|protocol message| DR
    MT -->|protocol message| DR
    LAN -->|network message| DR

    DR -->|implements / represents| DEV
    DEV -->|exposes| CAP
    CAP -->|defines attributes| STATE
    DR -->|parse / sendEvent| STATE

    STATE -->|event| SUB
    SUB -->|activates| APP
    SCH -->|invokes| APP
    APP -->|evaluates / reads| AUT
    AUT -->|controls flow| ACT
    APP -->|executes| ACT

    APP -->|read / write| HV
    HV -->|shared context| AUT
    APP -->|Run Rule Actions / call function| RF
    RF -->|executes / returns value| ACT

    ACT -->|issues command| DEV
    DEV -->|driver command| DR
    DR -.->|cluster command| ZB
    DR -.->|command class| ZW
    DR -.->|Matter command| MT
    DR -.->|HTTP / socket| LAN

    ES -->|REST / endpoint call| API
    API -->|read / command selected devices| DEV
    STATE -.->|callback / event exposure| API

    OH -->|LAN| HM
    HM -->|shared device representation| DEV
    HM -->|variable sharing| HV

    DEV -.->|parent to child| DEV
    APP -.->|parent to child / rule to rule| APP

    DR -.->|logs / state| DIAG
    DEV -.->|events / status| DIAG
    APP -.->|logs / subscriptions / jobs| DIAG
    SCH -.->|scheduled jobs| DIAG
